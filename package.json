{
  "name": "sunhub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/cesium.mjs && vite",
    "build": "node scripts/icones.mjs && node scripts/og.mjs && tsc -b && vite build && node --experimental-strip-types scripts/prerender.mjs",
    "lint": "biome check src scripts",
    "preview": "vite preview",
    "cesium": "node scripts/cesium.mjs",
    "postinstall": "node scripts/cesium.mjs",
    "og": "node scripts/og.mjs",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "apk": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "formatar": "biome check --write src scripts",
    "icones": "node scripts/icones.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/share": "^8.0.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "cesium": "^1.145.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@capacitor/cli": "^8.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
